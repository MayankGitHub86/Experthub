{
  "name": "experthub-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ExpertHub: Professional expert consultation platform",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:lint": "cd frontend && npm run lint",
    "frontend:preview": "cd frontend && npm run preview",
    "backend:start": "cd backend && npm run start",
    "backend:dev": "cd backend && npm run dev",
    "backend:test": "cd backend && npm test",
    "dev": "echo 'Run frontend and backend separately:\\n  - Frontend: npm run frontend:dev\\n  - Backend: npm run backend:start'",
    "build": "npm run frontend:build"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
