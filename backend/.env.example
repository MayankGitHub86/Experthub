PORT=3001
CORS_ORIGIN=http://localhost:5173
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Connect Platform (required for expert onboarding)
# Legal entity country for the platform (e.g., 'US', 'GB', 'CA')
STRIPE_PLATFORM_COUNTRY=US

# Platform Stripe account ID (optional; if not set, uses default account)
STRIPE_PLATFORM_ACCOUNT_ID=

# Platform commission percentage (default: 15)
STRIPE_COMMISSION_PERCENTAGE=15

WORDPRESS_URL=http://localhost:8000
