{
  "name": "experthub-backend-microservice",
  "version": "1.0.0",
  "description": "Real-time Socket.io and AI matching microservice for ExpertHub",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:concurrency": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js booking-concurrency.test.js --verbose"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "socket.io": "^4.7.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
