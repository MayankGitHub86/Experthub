# Test Environment - MongoDB rs0 on port 27018
NODE_ENV=test

# Server
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database - TEST REPLICA SET
MONGODB_URI=mongodb://127.0.0.1:27018/experthub_test?directConnection=true&retryWrites=true&w=majority

# JWT (test keys)
JWT_SECRET=test-super-secret-jwt-key-change-this-in-production-12345
JWT_REFRESH_SECRET=test-super-secret-refresh-key-change-this-in-production-67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (test - disabled)
EMAIL_FROM=test@experthub.com
SENDGRID_API_KEY=test-key

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=test-webhook

# OpenAI
OPENAI_API_KEY=test-key
OPENAI_MODEL=gpt-4

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Sentry (optional)
SENTRY_DSN=
